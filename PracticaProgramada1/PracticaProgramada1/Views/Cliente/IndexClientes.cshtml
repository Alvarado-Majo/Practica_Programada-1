@using PracticaProgramada1.BLL.DTO;
@model List<PracticaProgramada1.BLL.DTO.ClienteDTO>


@{
    ViewData["Title"] = "Mantenimiento de Clientes";
}

<link rel="stylesheet" href="~/css/cliente.css" asp-append-version="true" />

<div class="container my-4">
    <div class="card shadow-sm">

        <!-- Header -->
        <div class="card-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0">Lista de Clientes</h2>
            <div>
                <button type="button" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#modalCrearCliente">
                    Crear Cliente
                </button>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblClientes" class="table table-hover table-bordered align-middle" style="width:100%">

                    <thead class="table-light">
                        <tr>
                            <th style="width:6%">ID</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Fecha Registro</th>
                            <th style="width:18%">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>@cliente.ID</td>
                                    <td>@cliente.Nombre</td>
                                    <td>@cliente.Apellido</td>
                                    <td>@cliente.Email</td>
                                    <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        <button class="btn btn-primary btn-sm"
                                                onclick="editarCliente(@cliente.ID)">
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                onclick="eliminarCliente(@cliente.ID)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No hay registros disponibles
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

    </div>

    <!-- Modales -->
    @await Html.PartialAsync("_EditarCliente", new ClienteDTO())
    @await Html.PartialAsync("_CrearCliente", new ClienteDTO())



</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/cliente.js" asp-append-version="true"></script>
}


